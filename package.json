{
  "name": "agy-openai-bridge",
  "version": "0.1.0",
  "description": "Expose Google's Antigravity CLI (agy) as an OpenAI-compatible endpoint for OpenCode V2 and other clients",
  "license": "MIT",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "supervise": "node scripts/supervise.mjs --start",
    "stop": "node scripts/supervise.mjs --stop",
    "smoke": "node smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "antigravity",
    "agy",
    "opencode",
    "openai-compatible",
    "gemini",
    "bridge"
  ]
}
